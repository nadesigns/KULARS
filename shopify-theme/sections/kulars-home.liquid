<!-- ============ HERO ============ -->
<section class="hero" data-section="hero">
  <div class="hero__media" id="heroMedia">
    <figure class="hero__slide is-active">
      <div class="hero__frame">
        <img src="{{ 'hero-drill.webp' | asset_url }}" alt="Players in Kulars training singlets and bibs during a drill" fetchpriority="high">
        <div class="spots">
          <a href="#teamwear" class="spot" data-open="singlet" data-x="49" data-y="34" data-side="left"></a>
          <a href="#teamwear" class="spot" data-open="bib" data-x="70" data-y="31" data-side="right"></a>
        </div>
      </div>
    </figure>
    <figure class="hero__slide">
      <div class="hero__frame">
        <img src="{{ 'hero-jacket.webp' | asset_url }}" alt="Player warming up in the Kulars All-Weather Training Jacket">
        <div class="spots">
          <a href="#teamwear" class="spot" data-open="jacket" data-x="47" data-y="38" data-side="right"></a>
        </div>
      </div>
    </figure>
    <figure class="hero__slide">
      <div class="hero__frame">
        <img src="{{ 'coach.webp' | asset_url }}" alt="Coach in the Kulars track jacket">
        <div class="spots">
          <a href="#teamwear" class="spot" data-open="coach" data-x="62" data-y="44" data-side="right"></a>
        </div>
      </div>
    </figure>
  </div>
  <div class="hero__shade"></div>

  <div class="hero__content">
    <p class="eyebrow hero__eyebrow"><svg viewBox="0 0 160 188" fill="currentColor"><use href="#k-mark"/></svg> Teamwear 26</p>
    <h1 class="hero__title" aria-label="Wear the change">
      <span class="line"><span class="split">Wear the</span></span>
      <span class="line"><span class="split"><em>change.</em></span></span>
    </h1>
    <div class="hero__ctas">
      <a href="#teamwear" class="btn btn--light magnetic"><span>Shop the kit</span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a href="/pages/our-story" class="btn btn--ghost magnetic"><span>Our story</span></a>
    </div>
  </div>

  <div class="hero__bar">
    <div class="hero__dots" id="heroDots">
      <button type="button" class="is-active" aria-label="Slide 1"><i></i></button>
      <button type="button" aria-label="Slide 2"><i></i></button>
      <button type="button" aria-label="Slide 3"><i></i></button>
    </div>
  </div>
</section>

<!-- ============ SHOP STRIP ============ -->
<section class="strip" data-section="rich-text">
  <p class="strip__title">KULARS Official Shop</p>
  <p class="strip__sub">Soccer-inspired apparel where every purchase has a purpose.</p>
</section>

<!-- ============ CATEGORY TILES ============ -->
<section class="cats" aria-label="Shop by category" data-section="collection-list">
  <a href="/pages/teamwear?cat=training" class="tile" data-cursor="Shop"><img src="{{ 'singlet-pair.webp' | asset_url }}" alt="Two players passing in training singlets" loading="lazy"><span class="tile__name">Training</span><span class="tile__cta">Shop now</span></a>
  <a href="/pages/teamwear?cat=jackets" class="tile" data-cursor="Shop"><img src="{{ 'jacket-run.webp' | asset_url }}" alt="Player running in the All-Weather Training Jacket" loading="lazy"><span class="tile__name">Jackets</span><span class="tile__cta">Shop now</span></a>
  <a href="/pages/club-shop" class="tile" data-cursor="Shop"><img src="{{ 'fan-hoodie-rust.webp' | asset_url }}" alt="Supporter in a crest hoodie" loading="lazy"><span class="tile__name">Fanwear</span><span class="tile__cta">Shop now</span></a>
  <a href="/pages/teamwear?cat=bags" class="tile" data-cursor="Shop"><img src="{{ 'backpack.webp' | asset_url }}" alt="Kulars club backpack" loading="lazy"><span class="tile__name">Bags &amp; Gear</span><span class="tile__cta">Shop now</span></a>
</section>

<!-- ============ TEAMWEAR ROW ============ -->
<section class="prow" id="teamwear" data-section="featured-collection">
  <div class="prow__head">
    <p class="eyebrow">Collection</p>
    <h2 class="display"><span class="line"><span class="split">Teamwear</span></span></h2>
    <p class="prow__copy">Training, travel and warm-up wear built for clubs at every level. Every piece sends 5% back to the game.</p>
    <div class="prow__links"><a href="/pages/teamwear" class="btn btn--dark btn--sm"><span>Shop all teamwear</span></a><a href="/pages/custom-kits" class="link-arrow">Kit your club <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
  </div>
  <div class="prow__body">
    <div class="track" id="teamwearGrid"></div>
    <div class="track__nav">
      <button type="button" class="arrow" data-track="teamwearGrid" data-dir="-1" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
      <span class="track__bar"><i></i></span>
      <button type="button" class="arrow" data-track="teamwearGrid" data-dir="1" aria-label="Next"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>
  </div>
</section>

<!-- ============ IMPACT BAND ============ -->
<section class="impact" data-section="impact">
  <div class="wrap impact__grid">
    <div class="impact__num" aria-label="5 percent"><span id="impactNum">5</span><i>%</i></div>
    <div class="impact__copy">
      <p class="eyebrow">Every purchase has a purpose</p>
      <p class="impact__lede">of every product sold supports underprivileged football communities.</p>
      <p>You're not simply buying something to wear. You're helping someone else get an opportunity to play.</p>
    </div>
    <ul class="impact__list">
      <li><small>Helps provide</small><b>Equipment</b></li>
      <li><small>Helps support</small><b>Training</b></li>
      <li><small>Opens up</small><b>Programs</b></li>
      <li><small>Puts a player</small><b>On the field</b></li>
    </ul>
  </div>
</section>

