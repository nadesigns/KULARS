    <h2 class="display"><span class="line"><span class="split">Clubs in Kulars</span></span></h2>
    <p>Our kit on the pitch, in the stands and on the clubs we partner with.</p>
  </div>
  <div class="mosaic">
    <a href="/pages/clubs" class="m m--half" data-cursor="View" data-club><img src="{{ 'walk.webp' | asset_url }}" alt="Staten Island Athletic SC squad walking off the pitch in Kulars kit" loading="lazy"><span class="m__tag">Featured club</span><span class="m__cap">Staten Island Athletic SC</span></a>
    <a href="/pages/clubs" class="m m--half" data-cursor="View"><img src="{{ 'keeper-1.webp' | asset_url }}" alt="Goalkeeper warming up in the All-Weather Training Jacket" loading="lazy"><span class="m__cap">The All-Weather Jacket</span></a>
    <a href="/pages/clubs" class="m m--quarter" data-cursor="View"><img src="{{ 'jacket-touch.webp' | asset_url }}" alt="Player juggling in the training jacket" loading="lazy"><span class="m__cap">First touch</span></a>
    <a href="/pages/clubs" class="m m--quarter" data-cursor="View"><img src="{{ 'singlet-duo.webp' | asset_url }}" alt="Two players on the ball in singlet and jacket" loading="lazy"><span class="m__cap">One v one</span></a>
    <a href="/pages/clubs" class="m m--quarter" data-cursor="View"><img src="{{ 'coach.webp' | asset_url }}" alt="Coach in the Kulars track jacket" loading="lazy"><span class="m__cap">Coaches' wear</span></a>
    <a href="/pages/clubs" class="m m--quarter" data-cursor="View"><img src="{{ 'armband.webp' | asset_url }}" alt="Captain's armband with the Kulars K" loading="lazy"><span class="m__cap">Your crest. Our K.</span></a>
    <a href="/pages/club-shop" class="m m--third" data-cursor="View"><img src="{{ 'locker.webp' | asset_url }}" alt="Locker with the club backpack and armband" loading="lazy"><span class="m__cap">Matchday locker</span></a>
    <a href="/pages/club-shop" class="m m--third" data-cursor="View"><img src="{{ 'fan-scarf-up.webp' | asset_url }}" alt="Supporter holding a scarf above his head" loading="lazy"><span class="m__cap">From the stands</span></a>
    <a href="/pages/clubs" class="m m--third" data-cursor="View"><img src="{{ 'keeper-2.webp' | asset_url }}" alt="Goalkeeper mid-stride in the training jacket" loading="lazy"><span class="m__cap">Keeper sessions</span></a>
  </div>
</section>

<!-- ============ CLUB SHOP ROW ============ -->
