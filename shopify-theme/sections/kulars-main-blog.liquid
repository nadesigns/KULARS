<section class="section">
  <div class="wrap">
    <h1 class="h-display">{{ page_title }}</h1>
    {% if article %}<div class="rte">{{ article.content }}</div>{% else %}{% for a in blog.articles %}<p><a href="{{ a.url }}">{{ a.title }}</a></p>{% endfor %}{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Blog",
  "tag": "div",
  "class": "kulars-section"
}
{% endschema %}
