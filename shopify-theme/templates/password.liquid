{% layout 'password' %}
<div class="pw__pattern" aria-hidden="true"></div>

<header class="pw__top">
  <span>Unity · Love · Respect</span>
  <span class="pw__top-mid">Keeping Unity, Love And Respect in Society</span>
  <span>Wear the change</span>
</header>

<main class="pw__main">
  <h1 class="pw__logo">
    <span class="visually-hidden">{{ shop.name }}</span>
    {% render 'kulars-lockup' %}
  </h1>

  <div class="pw__copy">
    <h2 class="pw__title"><span class="pw__line"><span>Wear the</span></span> <span class="pw__line"><span><em>change.</em></span></span></h2>
    <p class="pw__lede">
      {%- if shop.password_message != blank -%}{{ shop.password_message | escape }}
      {%- else -%}Soccer-inspired apparel. 5% of every product sold supports underprivileged football communities.{%- endif -%}
    </p>
  </div>

  {%- form 'customer', class: 'pw__notify' -%}
    <input type="hidden" name="contact[tags]" value="password page, prospect">
    {%- if form.posted_successfully? -%}
      <p class="pw__done" role="status"><b>You're on the list.</b> We'll email you the moment the doors open.</p>
    {%- else -%}
      <label class="pw__field">
        <span class="visually-hidden">Email</span>
        <input type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required>
        <button type="submit"><span>Notify me</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </label>
      {%- if form.errors -%}<p class="pw__error" role="alert">That email doesn't look right. Try again.</p>{%- endif -%}
      <p class="pw__hint">Be first in line for the launch drop. No spam, ever.</p>
    {%- endif -%}
  {%- endform -%}
</main>

<footer class="pw__foot">
  <details class="pw__gate" id="pwGate">
    <summary><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Enter with password</span></summary>
    {%- form 'storefront_password', class: 'pw__unlock' -%}
      <label class="pw__field pw__field--pass">
        <span class="visually-hidden">Store password</span>
        <input type="password" name="password" placeholder="Store password" autocomplete="current-password" required{% if form.errors %} aria-invalid="true"{% endif %}>
        <button type="submit"><span>Enter</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </label>
      {%- if form.errors -%}<p class="pw__error" role="alert">That password isn't right. Try again.</p>
      <script>document.getElementById('pwGate').open = true;</script>{%- endif -%}
    {%- endform -%}
  </details>
  <div class="pw__legal">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <a href="/admin">Store owner? Log in</a>
  </div>
</footer>

<script>
  // focus the field when the gate opens
  document.getElementById('pwGate').addEventListener('toggle', e => {
    if (!e.target.open) return;
    const input = e.target.querySelector('input');
    input.focus({ preventScroll: true });
    // bring the field and its button above the browser toolbar / keyboard
    setTimeout(() => e.target.querySelector('.pw__unlock').scrollIntoView({ block: 'end', behavior: 'smooth' }), 60);
  });
</script>
