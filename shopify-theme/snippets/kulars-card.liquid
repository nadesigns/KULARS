{%- comment -%} Product card in the site's .card style. Kulars-tagged products open the quick view; others link through. {%- endcomment -%}
{%- liquid
  assign kid = ''
  for tag in product.tags
    if tag contains 'kulars:'
      assign kid = tag | remove_first: 'kulars:'
    endif
  endfor
-%}
<article class="card" data-reveal>
  <a class="card__media" href="{{ product.url }}" data-cursor="View"{% if kid != blank %} data-open="{{ kid }}"{% endif %}>
    {%- unless product.available -%}<span class="card__tag">Sold out</span>{%- endunless -%}
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: class: 'img-a', loading: 'lazy', alt: product.title, widths: '400,600,900', sizes: '(min-width: 900px) 25vw, 50vw' }}
    {%- endif -%}
    {%- if product.images.size > 1 -%}
      {{ product.images[1] | image_url: width: 900 | image_tag: class: 'img-b', loading: 'lazy', alt: '', widths: '400,600,900', sizes: '(min-width: 900px) 25vw, 50vw' }}
    {%- endif -%}
    {%- if kid != blank -%}<span class="card__quick">Quick add <span aria-hidden="true">+</span></span>{%- endif -%}
  </a>
  <div class="card__info">
    <div>
      <h3 class="card__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
      <p class="card__sub">{% if product.variants.size > 1 and product.options contains 'Color' %}{% assign colors = product.options_by_name['Color'].values %}{% if colors.size > 1 %}{{ colors.size }} colors{% else %}{{ colors.first }}{% endif %}{% else %}{{ product.type }}{% endif %}</p>
    </div>
    <span class="card__price">{% if product.price_varies %}From {% endif %}{{ product.price | money_without_trailing_zeros }}</span>
  </div>
</article>
